{
  "name": "hackvault",
  "version": "0.1.0",
  "description": "A peer-to-peer encrypted secret vault with automatic .env mirroring.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "hackvault": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills/hackvault-context/SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:unit": "tsx --test test/crypto.test.ts test/validation.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "check": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ram4-dev/pears-vault.git"
  },
  "keywords": [
    "pear-runtime",
    "hyperdht",
    "hypercore",
    "hyperbee",
    "secrets"
  ],
  "author": "ram4-dev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "compact-encoding": "^3.3.2",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.35.2",
    "hyperdht": "^6.33.2",
    "protomux": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
